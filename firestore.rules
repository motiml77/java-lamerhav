rules_version = '2';

// ============================================================================
//  כללי אבטחה ל-Firestore — אתר "Java לבגרות"
//  מתאימים בדיוק למבנה הנתונים של האפליקציה (app.html).
//
//  איך מעלים (פעם אחת):
//   Firebase Console  →  הפרויקט exams-a93fb  →  Build → Firestore Database
//   →  לשונית  Rules  →  להדביק את כל הקובץ הזה  →  Publish.
//
//  עיקרון: הבדיקה "מנהל/תלמידה" שבקוד היא רק לתצוגה. האבטחה האמיתית כאן —
//  בשרת — ולכן אי אפשר לעקוף אותה דרך הדפדפן.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- עזרי הרשאה ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // חשבון המורה היחיד. אם מחליפים אימייל — לעדכן גם כאן וגם בקוד (EDITOR_EMAIL).
    function isTeacher() {
      return isSignedIn()
        && request.auth.token.email == 'motiml77@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // האימייל ששמור על המסמך זהה למשתמשת המחוברת (לכתיבה / לקריאה).
    function ownsIncoming() {
      return isSignedIn() && request.resource.data.email == request.auth.token.email;
    }
    function ownsExisting() {
      return isSignedIn() && resource.data.email == request.auth.token.email;
    }

    // ---------- תוכן לימודי: נושאים, שאלות, הגדרות ----------
    // כל מי שמחוברת יכולה לקרוא. רק המורה כותבת.
    match /classes/{classId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    match /questions/{questionId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    match /exam_settings/{examId} {
      // מחזיק כעת רק את ה-prompt לשיעורי בית (שהתלמידה צריכה לבדיקה עצמית).
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    // מחוון הבדיקה של המבחנים (הנחיות כלליות + דגשים לכל שאלה) — למורה בלבד.
    // התלמידות לעולם אינן יכולות לקרוא אותו.
    match /grading_rubrics/{examId} {
      allow read, write: if isTeacher();
    }

    // ---------- פרופילי תלמידות ----------
    match /users/{uid} {
      // תלמידה קוראת רק את הפרופיל שלה; המורה קוראת את כולם.
      allow get: if isSignedIn()
                 && (resource == null
                     || isTeacher()
                     || resource.data.email == request.auth.token.email);
      allow list: if isTeacher();

      // הרשמה ראשונה: חייבת להיות המשתמשת עצמה, ותמיד מתחילה כ"לא מאושרת".
      allow create: if ownsIncoming()
                    && request.resource.data.approved == false;

      // תלמידה יכולה לעדכן שם/שכבה — אך לא לאשר את עצמה. המורה יכולה הכול.
      allow update: if isTeacher()
                    || (ownsExisting()
                        && ownsIncoming()
                        && request.resource.data.approved == resource.data.approved);

      allow delete: if isTeacher();
    }

    // ---------- תשובות: מבחנים ----------
    match /exam_responses/{examId} {
      // המסמך-אב (רשימת המבחנים) — למורה בלבד.
      allow read, write: if isTeacher();

      match /students/{sid} {
        // קריאה: המורה, או התלמידה את התשובה שלה בלבד (מסמך לא-קיים אינו חושף דבר).
        allow read: if isTeacher() || resource == null || ownsExisting();

        // יצירה: רק את המסמך של עצמה, ובלי לזייף ציון סופי.
        allow create: if isTeacher()
                      || (ownsIncoming()
                          && !request.resource.data.keys().hasAny(['sentToStudent', 'finalGrade']));

        // עדכון: רק את המסמך של עצמה, ובלי לשנות/להוסיף שדות ציון של המורה.
        allow update: if isTeacher()
                      || (ownsExisting() && ownsIncoming()
                          && !request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['sentToStudent', 'finalGrade']));

        allow delete: if isTeacher();
      }
    }

    // ---------- תשובות: שיעורי בית ----------
    match /homework_responses/{examId} {
      allow read, write: if isTeacher();

      match /students/{sid} {
        allow read: if isTeacher() || resource == null || ownsExisting();

        allow create: if isTeacher()
                      || (ownsIncoming()
                          && !request.resource.data.keys().hasAny(['sentToStudent', 'finalGrade']));

        allow update: if isTeacher()
                      || (ownsExisting() && ownsIncoming()
                          && !request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['sentToStudent', 'finalGrade']));

        allow delete: if isTeacher();
      }
    }

    // ---------- מדיה לנושאים: סרטונים וקבצים ----------
    // platform_media — תוכן גלובלי לכל בתי הספר (לפי כותרת נושא). כותב: המנהל הראשי בלבד.
    match /platform_media/{mediaId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }
    // media — תוכן של בית הספר הנוכחי (מצב legacy, לפני המעבר ל-schools/{slug}/media).
    match /media/{mediaId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    // ---------- שאלות תרגול קבועות ----------
    // platform_questions — שאלות גלובליות לכל בתי הספר. כותב: המנהל הראשי בלבד.
    match /platform_questions/{qId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    // platform_lessons/{topicKey} — תוכן השיעור הגלובלי, דורס את התוכן המובנה
    // בכל בתי הספר. עמוד קורס שמורה בנתה לכיתה שלה עדיין גובר עליו.
    match /platform_lessons/{topicKey} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }
    // practice — שאלות של בית הספר הנוכחי (מצב legacy).
    match /practice/{qId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    // ---------- הגדרות פלטפורמה (פרסום) ----------
    // מסמך יחיד platform_settings/ads. קריאה פתוחה — אלו תמונות פרסום בלבד,
    // והחלון הקופץ נטען כבר במסך הכניסה. כתיבה: המנהל הראשי בלבד.
    match /platform_settings/{docId} {
      allow read:  if true;
      allow write: if isTeacher();
    }

    // ---------- רישום כניסות (מצב legacy) ----------
    // מזהה המסמך הוא email__YYYY-MM-DD, ולכן כניסה נספרת פעם ביום למשתמשת.
    // כל אחת כותבת רק את הרשומה שלה; רק המנהל קורא.
    match /activity/{id} {
      allow read:   if isTeacher();
      allow create: if isSignedIn() && ownsIncoming();
      allow update: if isSignedIn() && ownsExisting() && ownsIncoming();
      allow delete: if isTeacher();
    }

    // ================================================================
    // בתי ספר — העץ הרב-בית-ספרי המלא (docs/multi-school-plan.md §6, שלב 3)
    // החוקים לאוספי השורש שלמעלה נשארים בכוונה — מצב legacy של lamerhav
    // עד השלמת המיגרציה (שלב 6). אז הם יימחקו והשורש ייחסם.
    // ================================================================

    // המנהל הראשי — קבוע
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'motiml77@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // מסמך בית הספר של הבקשה הנוכחית (קריאה אחת, עם cache פנימי של Firestore)
    function schoolDoc(school) {
      return get(/databases/$(database)/documents/schools/$(school)).data;
    }

    // המורה האחראי של בית הספר — השוואה בלי תלות באותיות גדולות/קטנות
    function isSchoolTeacher(school) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && schoolDoc(school).teacherEmail.lower() == request.auth.token.email.lower();
    }

    // ההשהיה נאכפת כאן — בשרת, לא רק בתצוגה
    function isActive(school) {
      return schoolDoc(school).status == 'active';
    }

    // "מורה" בהקשר בית ספר: המורה האחראי (רק כשפעיל) או המנהל הראשי (תמיד)
    function canManage(school) {
      return isSuperAdmin() || (isSchoolTeacher(school) && isActive(school));
    }

    // תלמידה מחוברת בבית ספר פעיל
    function isActiveUser(school) {
      return isSignedIn() && isActive(school);
    }

    match /schools/{school} {
      // מטא-דאטה נקראת גם לפני התחברות (מסך כניסה / "לא נמצא" / "מושהה").
      // list חסום — אי אפשר למפות את בתי הספר; צריך לדעת slug מדויק.
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      // המנהל — הכול; המורה — שדות תצוגה בלבד, לא teacherEmail/status/slug
      allow update: if isSuperAdmin()
        || (isSchoolTeacher(school) && isActive(school)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['teacherEmail', 'status', 'slug']));

      // ---------- תוכן לימודי ----------
      match /classes/{classId} {
        allow read: if isActiveUser(school) || isSuperAdmin();
        allow write: if canManage(school);
      }
      match /questions/{questionId} {
        allow read: if isActiveUser(school) || isSuperAdmin();
        allow write: if canManage(school);
      }
      match /exam_settings/{examId} {
        allow read: if isActiveUser(school) || isSuperAdmin();
        allow write: if canManage(school);
      }
      // מחוון הבדיקה — למורה בלבד, כמו היום
      match /grading_rubrics/{examId} {
        allow read, write: if canManage(school);
      }
      match /notifications/{id} {
        allow read: if isActiveUser(school) || isSuperAdmin();
        allow write: if canManage(school);
      }
      // סרטונים וקבצים של בית הספר (המקבילה של media בשורש)
      match /media/{mediaId} {
        allow read: if isActiveUser(school) || isSuperAdmin();
        allow write: if canManage(school);
      }
      // שאלות תרגול קבועות של בית הספר
      match /practice/{qId} {
        allow read: if isActiveUser(school) || isSuperAdmin();
        allow write: if canManage(school);
      }

      // ---------- רישום כניסות ----------
      // מזהה המסמך email__YYYY-MM-DD מונע כפילות ברמת השרת.
      match /activity/{id} {
        allow read:   if canManage(school);
        allow create: if isActiveUser(school) && ownsIncoming();
        allow update: if isActiveUser(school) && ownsExisting() && ownsIncoming();
        allow delete: if canManage(school);
      }

      // ---------- תלמידות ----------
      match /users/{uid} {
        allow get: if canManage(school)
                   || (isActiveUser(school)
                       && (resource == null || resource.data.email == request.auth.token.email));
        allow list: if canManage(school);
        // הרשמה: המשתמשת עצמה, תמיד לא-מאושרת בהתחלה
        allow create: if isActiveUser(school) && ownsIncoming()
                      && request.resource.data.approved == false;
        // תלמידה מעדכנת שם/שכבה/כיתה — לא את approved
        allow update: if canManage(school)
                      || (isActiveUser(school) && ownsExisting() && ownsIncoming()
                          && request.resource.data.approved == resource.data.approved);
        allow delete: if canManage(school);
      }

      // ---------- תשובות: מבחנים ----------
      match /exam_responses/{examId} {
        allow read, write: if canManage(school);
        match /students/{sid} {
          allow read: if canManage(school) || resource == null
                      || (isActiveUser(school) && ownsExisting());
          allow create: if canManage(school)
                        || (isActiveUser(school) && ownsIncoming()
                            && !request.resource.data.keys().hasAny(['sentToStudent', 'finalGrade']));
          allow update: if canManage(school)
                        || (isActiveUser(school) && ownsExisting() && ownsIncoming()
                            && !request.resource.data.diff(resource.data)
                                  .affectedKeys().hasAny(['sentToStudent', 'finalGrade']));
          allow delete: if canManage(school);
        }
      }

      // ---------- תשובות: שיעורי בית (זהה למבחנים) ----------
      match /homework_responses/{examId} {
        allow read, write: if canManage(school);
        match /students/{sid} {
          allow read: if canManage(school) || resource == null
                      || (isActiveUser(school) && ownsExisting());
          allow create: if canManage(school)
                        || (isActiveUser(school) && ownsIncoming()
                            && !request.resource.data.keys().hasAny(['sentToStudent', 'finalGrade']));
          allow update: if canManage(school)
                        || (isActiveUser(school) && ownsExisting() && ownsIncoming()
                            && !request.resource.data.diff(resource.data)
                                  .affectedKeys().hasAny(['sentToStudent', 'finalGrade']));
          allow delete: if canManage(school);
        }
      }
    }

    // ---------- ברירת מחדל: הכול חסום ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================================
//  המלצות הקשחה נוספות (לא חובה, אך מומלץ):
//
//  1. Authentication → Sign-in method: להשאיר מופעל את Google בלבד.
//  2. Authentication → Settings → Authorized domains: להשאיר רק את הדומיינים
//     שלך (exams-a93fb.firebaseapp.com + הדומיין שבו האתר מתארח).
//  3. מחוון הבדיקה של מבחנים (הנחיות כלליות + דגשים לכל שאלה) מאוחסן באוסף
//     grading_rubrics ושמור למורה בלבד — תלמידה לא יכולה לקרוא אותו. ה-prompt
//     של שיעורי בית נשאר ב-exam_settings (התלמידה צריכה אותו לבדיקה עצמית).
//  4. ציון ה-AI האוטומטי בשיעורי בית מחושב בצד הלקוח — לכן הוא "מייעץ" בלבד.
//     הציון הקובע הוא זה שהמורה שולחת ("שליחה לתלמידה"), והוא מוגן בכללים למעלה
//     (תלמידה לא יכולה לכתוב finalGrade / sentToStudent).
//  5. App Check (אופציונלי) — מונע שימוש ב-API מחוץ לאתר שלך.
// ============================================================================
