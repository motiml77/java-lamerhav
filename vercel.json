{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/app.bundle.:hash.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/lamerhav",
      "statusCode": 308
    }
  ],
  "rewrites": [
    {
      "source": "/manage",
      "destination": "/app.html"
    },
    {
      "source": "/:school([a-z0-9][a-z0-9-]{1,28}[a-z0-9])",
      "destination": "/app.html"
    },
    {
      "source": "/:school([a-z0-9][a-z0-9-]{1,28}[a-z0-9])/app",
      "destination": "/app.html"
    }
  ]
}
