DSVIZ	1	cs
SRC	Fact.cs	using System;\n\npublic class Program\n{\n    static int Fact(int n)\n    {\n        if (n <= 1) return 1;\n        return n * Fact(n - 1);\n    }\n\n    public static void Main(string[] args)\n    {\n        int x = Fact(5);\n        Console.WriteLine(x);\n    }\n}\n
