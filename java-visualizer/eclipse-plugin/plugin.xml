<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.commands">
      <category id="il.lamerhav.dsviz.category" name="מבני נתונים"/>
      <command id="il.lamerhav.dsviz.newExercise" categoryId="il.lamerhav.dsviz.category"
               name="תרגיל חדש" description="תרגיל חדש במבני נתונים עם מעטפת מוכנה"
               defaultHandler="il.lamerhav.dsviz.NewExerciseHandler">
         <commandParameter id="il.lamerhav.dsviz.structure" name="מבנה" optional="true"/>
      </command>
      <command id="il.lamerhav.dsviz.run" categoryId="il.lamerhav.dsviz.category"
               name="הרצה ויזואלית" description="הרצת התרגיל בחלון שמראה כל שורה, את המשתנים ואת מבני הנתונים"
               defaultHandler="il.lamerhav.dsviz.RunVisualHandler"/>
      <command id="il.lamerhav.dsviz.insert" categoryId="il.lamerhav.dsviz.category"
               name="הוסף מבנה נתונים" description="בוחרים מבנה נתונים, ערכים ושם — והוא נבנה בקוד במקום הסמן"
               defaultHandler="il.lamerhav.dsviz.InsertHandler">
         <commandParameter id="il.lamerhav.dsviz.structure" name="מבנה" optional="true"/>
      </command>
      <command id="il.lamerhav.dsviz.submit" categoryId="il.lamerhav.dsviz.category"
               name="שליחת תרגיל" description="שולחים את דף התרגיל (PDF, Word או תמונות) ומקבלים מעטפת מוכנה: מחלקות, main ופעולה לכל סעיף"
               defaultHandler="il.lamerhav.dsviz.SubmitHandler"/>
      <command id="il.lamerhav.dsviz.solution" categoryId="il.lamerhav.dsviz.category"
               name="הצעה לפתרון" description="הצעה לפתרון של הסעיף שבו נמצא הסמן (בתרגילים שנוצרו ב&quot;שליחת תרגיל&quot;)"
               defaultHandler="il.lamerhav.dsviz.SolutionHandler"/>
      <command id="il.lamerhav.dsviz.help" categoryId="il.lamerhav.dsviz.category"
               name="הדרכה לשימוש" description="סרטונים קצרים שמסבירים איך משתמשים"
               defaultHandler="il.lamerhav.dsviz.HelpHandler"/>
      <command id="il.lamerhav.dsviz.examples" categoryId="il.lamerhav.dsviz.category"
               name="דוגמאות פתורות" description="העתקת דוגמאות פתורות לפרויקט"
               defaultHandler="il.lamerhav.dsviz.ExamplesHandler"/>
      <command id="il.lamerhav.dsviz.power" categoryId="il.lamerhav.dsviz.category"
               name="כיבוי / הפעלה של DSViz" description="מכבה את כל היכולות של DSViz (נשאר רק Eclipse) — או מפעיל אותן מחדש"
               defaultHandler="il.lamerhav.dsviz.PowerHandler"/>
      <command id="il.lamerhav.dsviz.mentor" categoryId="il.lamerhav.dsviz.category"
               name="הסברים בעברית לשגיאות" description="ליד כל שגיאה של הקומפיילר — הסבר בעברית במקום המדויק של הבעיה, ואזהרות על טעויות נפוצות"
               defaultHandler="il.lamerhav.dsviz.MentorToggleHandler">
         <state class="org.eclipse.ui.handlers.RegistryToggleState:true" id="org.eclipse.ui.commands.toggleState"/>
      </command>
   </extension>

   <!-- DSViz פועל / כבוי (Power) — המשתנה שלפיו מוצגים הכפתורים והתפריטים -->
   <extension point="org.eclipse.ui.services">
      <sourceProvider provider="il.lamerhav.dsviz.Power">
         <variable name="il.lamerhav.dsviz.active" priorityLevel="workbench"/>
      </sourceProvider>
   </extension>

   <extension point="org.eclipse.ui.commandImages">
      <image commandId="il.lamerhav.dsviz.newExercise" icon="icons/new.png"/>
      <image commandId="il.lamerhav.dsviz.run" icon="icons/run.png"/>
      <image commandId="il.lamerhav.dsviz.examples" icon="icons/examples.png"/>
      <image commandId="il.lamerhav.dsviz.insert" icon="icons/insert.png"/>
      <image commandId="il.lamerhav.dsviz.help" icon="icons/help.png"/>
      <image commandId="il.lamerhav.dsviz.submit" icon="icons/send.png"/>
      <image commandId="il.lamerhav.dsviz.solution" icon="icons/solution.png"/>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <!-- תפריט ראשי: "מבני נתונים" -->
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu id="il.lamerhav.dsviz.menu" label="מבני נתונים">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
            <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש: מחסנית (Stack)..." style="push">
               <parameter name="il.lamerhav.dsviz.structure" value="stack"/>
            </command>
            <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש: תור (Queue)..." style="push">
               <parameter name="il.lamerhav.dsviz.structure" value="queue"/>
            </command>
            <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש: רשימה מקושרת (Node)..." style="push">
               <parameter name="il.lamerhav.dsviz.structure" value="list"/>
            </command>
            <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש: עץ בינארי (BinNode)..." style="push">
               <parameter name="il.lamerhav.dsviz.structure" value="tree"/>
            </command>
            <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש: עץ חיפוש בינארי..." style="push">
               <parameter name="il.lamerhav.dsviz.structure" value="bst"/>
            </command>
            <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש: מערך..." style="push">
               <parameter name="il.lamerhav.dsviz.structure" value="array"/>
            </command>
            <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש: מערך דו-ממדי..." style="push">
               <parameter name="il.lamerhav.dsviz.structure" value="matrix"/>
            </command>
            <!-- submit:start -->
            <command commandId="il.lamerhav.dsviz.submit" label="שליחת תרגיל (PDF / Word / תמונה)..." style="push"/>
            <command commandId="il.lamerhav.dsviz.solution" label="הצעה לפתרון לסעיף שבו נמצא הסמן..." style="push"/>
            <!-- submit:end -->
            <separator name="insert" visible="true"/>
            <command commandId="il.lamerhav.dsviz.insert" label="הוסף מבנה נתונים..." style="push"/>
            <separator name="run" visible="true"/>
            <command commandId="il.lamerhav.dsviz.run" label="הרצה ויזואלית" style="push"/>
            <separator name="more" visible="true"/>
            <command commandId="il.lamerhav.dsviz.examples" label="דוגמאות פתורות..." style="push"/>
            <command commandId="il.lamerhav.dsviz.mentor" label="הסברים בעברית לשגיאות ולטעויות נפוצות" style="toggle"/>
            <command commandId="org.eclipse.ui.views.showView" label="חלון ההסברים בעברית" style="push">
               <parameter name="org.eclipse.ui.views.showView.viewId" value="il.lamerhav.dsviz.mentorView"/>
            </command>
            <command commandId="il.lamerhav.dsviz.help" label="הדרכה לשימוש (?)..." style="push"/>
            <!-- כיבוי גם מהתפריט — לא רק מהלחצן האדום בסוף סרגל הכלים -->
            <separator name="power" visible="true"/>
            <command commandId="il.lamerhav.dsviz.power" label="כיבוי DSViz..." icon="icons/power-off.png" style="push" id="il.lamerhav.dsviz.menu.powerOff">
               <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
            </command>
         </menu>
      </menuContribution>
      <!-- כש-DSViz כבוי: במקום התפריט המלא — אותו שם, ובו רק "הפעלת DSViz" (כדי שתמיד תהיה דרך להחזיר, גם בלי סרגל הכלים) -->
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu id="il.lamerhav.dsviz.menuOff" label="מבני נתונים">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="false"/></with></visibleWhen>
            <command commandId="il.lamerhav.dsviz.power" label="הפעלת DSViz..." icon="icons/power-on.png" style="push" id="il.lamerhav.dsviz.menu.powerOn">
               <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="false"/></with></visibleWhen>
            </command>
         </menu>
      </menuContribution>

      <!-- סרגל הכלים -->
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar id="il.lamerhav.dsviz.toolbar" label="מבני נתונים">
            <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש" mode="FORCE_TEXT"
                     tooltip="תרגיל חדש במבני נתונים — בוחרים מבנה ומקבלים תרגיל מוכן" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
            <!-- submit:start -->
            <command commandId="il.lamerhav.dsviz.submit" label="שליחת תרגיל" mode="FORCE_TEXT"
                     tooltip="שליחת תרגיל: מצרפים את דף התרגיל (PDF, Word או תמונה / צילום מסך) ומקבלים קובץ מוכן — מחלקות, main ופעולה לכל סעיף" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
            <!-- submit:end -->
            <command commandId="il.lamerhav.dsviz.insert" label="הוסף מבנה נתונים" mode="FORCE_TEXT"
                     tooltip="הוסף מבנה נתונים לקוד במקום הסמן — בוחרים מבנה, ערכים ושם, ורואים איך הוא ייראה" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
            <separator name="run" visible="true"/>
            <command commandId="il.lamerhav.dsviz.run" label="הרצה ויזואלית" mode="FORCE_TEXT"
                     tooltip="הרצה בחלון שמראה כל שורה, את המשתנים ואת מבני הנתונים (הרצה רגילה — רק לקונסול)" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
            <separator name="help" visible="true"/>
            <command commandId="il.lamerhav.dsviz.help" label="הדרכה לשימוש (?)" tooltip="הדרכה לשימוש" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
            <separator name="power" visible="true"/>
            <!-- כיבוי (אדום) כש-DSViz פועל; הפעלה (ירוק) כשהוא כבוי — תמיד בסוף -->
            <command commandId="il.lamerhav.dsviz.power" label="כיבוי" mode="FORCE_TEXT" icon="icons/power-off.png"
                     tooltip="כיבוי DSViz: כל הכפתורים והיכולות נכבים, ונשאר רק Eclipse" style="push" id="il.lamerhav.dsviz.powerOff">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
            </command>
            <command commandId="il.lamerhav.dsviz.power" label="הפעלה" mode="FORCE_TEXT" icon="icons/power-on.png"
                     tooltip="הפעלת DSViz: מחזיר את כל הכפתורים והיכולות" style="push" id="il.lamerhav.dsviz.powerOn">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="false"/></with></visibleWhen>
            </command>
         </toolbar>
      </menuContribution>

      <!-- לחיצה ימנית בעורך הקוד -->
      <menuContribution locationURI="popup:#CompilationUnitEditorContext?after=additions">
         <command commandId="il.lamerhav.dsviz.insert" label="הוסף מבנה נתונים..." style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <command commandId="il.lamerhav.dsviz.run" label="הרצה ויזואלית" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <!-- submit:start -->
         <command commandId="il.lamerhav.dsviz.solution" label="הצעה לפתרון..." style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <!-- submit:end -->
      </menuContribution>

      <!-- לחיצה ימנית בעץ הקבצים -->
      <menuContribution locationURI="popup:org.eclipse.jdt.ui.PackageExplorer?after=additions">
         <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש במבני נתונים..." style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <!-- submit:start -->
         <command commandId="il.lamerhav.dsviz.submit" label="שליחת תרגיל..." style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <!-- submit:end -->
         <command commandId="il.lamerhav.dsviz.run" label="הרצה ויזואלית" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:org.eclipse.ui.navigator.ProjectExplorer#PopupMenu?after=additions">
         <command commandId="il.lamerhav.dsviz.newExercise" label="תרגיל חדש במבני נתונים..." style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <!-- submit:start -->
         <command commandId="il.lamerhav.dsviz.submit" label="שליחת תרגיל..." style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <!-- submit:end -->
         <command commandId="il.lamerhav.dsviz.run" label="הרצה ויזואלית" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
      </menuContribution>
   </extension>

   <!-- "המורה בעברית": ליד כל שגיאה של הקומפיילר הסבר בעברית (במקום המדויק של הבעיה), ואזהרות על טעויות נפוצות.
        סוג סימון משלנו (תת-סוג של Java Problem), ו-JDT מנקה אותו בכל בנייה (managedMarker) -->
   <!-- חלון "הסברים בעברית" — מימין לשמאל, צמוד לימין, ליד העורך (בערימה של Outline) -->
   <extension point="org.eclipse.ui.views">
      <category id="il.lamerhav.dsviz.views" name="מבני נתונים"/>
      <view id="il.lamerhav.dsviz.mentorView" category="il.lamerhav.dsviz.views" name="הסברים בעברית"
            class="il.lamerhav.dsviz.MentorView" icon="icons/help.png"/>
   </extension>
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="org.eclipse.jdt.ui.JavaPerspective">
         <view id="il.lamerhav.dsviz.mentorView" relative="org.eclipse.ui.views.ContentOutline" relationship="stack" visible="true"/>
      </perspectiveExtension>
   </extension>
   <extension id="mentor" point="org.eclipse.core.resources.markers" name="הסבר בעברית">
      <super type="org.eclipse.jdt.core.problem"/>
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="true"/>
   </extension>
   <extension point="org.eclipse.jdt.core.compilationParticipant">
      <compilationParticipant id="il.lamerhav.dsviz.mentorParticipant" class="il.lamerhav.dsviz.MentorParticipant" createsProblems="true">
         <managedMarker markerType="il.lamerhav.dsviz.mentor"/>
      </compilationParticipant>
   </extension>

   <!-- "הצעה לפתרון": כפתור עם מנורה מעל הכותרת של כל פעולה של סעיף (בתרגילים שנוצרו ב"שליחת תרגיל") — SolutionMinings -->
   <extension point="org.eclipse.ui.workbench.texteditor.codeMiningProviders">
      <codeMiningProvider id="il.lamerhav.dsviz.solutionMinings" class="il.lamerhav.dsviz.SolutionMinings" label="הצעה לפתרון">
         <enabledWhen>
            <with variable="editor">
               <instanceof value="org.eclipse.ui.texteditor.ITextEditor"/>
            </with>
         </enabledWhen>
      </codeMiningProvider>
   </extension>

   <!-- הכנה אוטומטית בהפעלה הראשונה (פרויקט, קידוד, ברוכים הבאים) -->
   <extension point="org.eclipse.ui.startup">
      <startup class="il.lamerhav.dsviz.AutoSetup"/>
   </extension>
</plugin>
