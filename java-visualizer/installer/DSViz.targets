<!--
  DSViz.targets — מותקן אוטומטית (SEC_CS ב-installer/setup.nsi) לתוך
    %LOCALAPPDATA%\Microsoft\MSBuild\Current\Microsoft.CSharp.targets\ImportAfter\DSViz.targets
  (ב-Mac: installer/mac/install.sh מתקין אותו ל-~/Library/Application Support/Microsoft/MSBuild/Current/Microsoft.CSharp.targets/ImportAfter)
  ומוסר בהסרת ההתקנה. זו נקודת הרחבה סטנדרטית של MSBuild (ברמת המשתמש — בלי הרשאות מנהל) שכל בנייה של
  פרויקט C# מייבאת אוטומטית — גם מ-Visual Studio (כולל הבנייה של עיצוב-זמן, שרצה כש-Visual Studio פותח/טוען
  את הפרויקט, בשביל ה-IntelliSense), וגם מ-dotnet build / dotnet msbuild. כך שבכל פרויקט קונסול ב-C#, חדש
  או קיים, בכל תיקייה, בלי שום פעולה של התלמיד:
    1. מתווספת הפניה לספרייה Unit4.CollectionsLib (אם קיימת בהתקנה, ואם הפרויקט לא כבר מפנה אליה —
       ב-Reference או ב-ProjectReference) — כדי ש-using Unit4.CollectionsLib; יתקמפל גם בבנייה הרגילה
       של Visual Studio (F5), ו-IntelliSense יכיר את Stack / Queue / Node / BinNode.
    2. מתווסף (פעם אחת) פרופיל ההרצה "הרצה ויזואלית" ל-Properties\launchSettings.json, בתפריט שליד כפתור
       ההפעלה הירוק — באמצעות dsviz-cs.exe ‎ensure-profile (קריאה קטנה: רק ה-csproj, בלי לסרוק את קבצי
       הפרויקט). פרופילים קיימים נשמרים. רק בפרויקטים מסוג SDK (רק בהם יש launchSettings.json).

  לא נוגע: בפרויקטים שאינם Exe (ספריות, בדיקות), בפרויקטים שאינם C#, ב-$(DSVizDisable)==true
  (אפשר לשים ב-csproj: <DSVizDisable>true</DSVizDisable>). הפניה — רק ל-‎.NET Core 2.0+ / ‎.NET 5+ /
  ‎.NET Framework 4.7.2+ (הספרייה היא netstandard2.0). פרופיל ההרצה — רק לפרויקט SDK של ‎.NET 6 ומעלה.
  כל שלב מוגן ב-Condition וב-ContinueOnError — הבנייה לא נכשלת אף פעם בגלל הקובץ הזה, גם אם ההתקנה
  של DSViz חסרה או חלקית, ואין בו שום פעולה בזמן הטעינה (evaluation) שיכולה להיכשל.
-->
<Project>

  <PropertyGroup>
    <!-- נתיבי ההתקנה (אפשר לדרוס מבחוץ לבדיקות: -p:DSVizInstallDir=... / -p:DSVizLibPath=... / -p:DSVizRunner=...).
         Mac (installer/mac/install.sh): $(LOCALAPPDATA) של MSBuild הוא ~/Library/Application Support (‎.NET 8 ומעלה), כלומר
         אותה תיקייה שההתקנה משתמשת בה; ב-SDK ישן (‎~/.local/share) — עוברים לתיקייה של ה-Mac. שם dsviz-cs בלי ‎.exe,
         ויש רווח בנתיב ("Application Support") — ב-Exec הנתיב במרכאות. ב-Windows — בדיוק כמו קודם. -->
    <_DSVizDefaultDir>$(LOCALAPPDATA)\DSViz</_DSVizDefaultDir>
    <_DSVizDefaultDir Condition="'$(OS)' != 'Windows_NT' and !Exists('$(_DSVizDefaultDir)') and Exists('$(HOME)/Library/Application Support/DSViz')">$(HOME)/Library/Application Support/DSViz</_DSVizDefaultDir>
    <DSVizInstallDir Condition="'$(DSVizInstallDir)' == ''">$(_DSVizDefaultDir)</DSVizInstallDir>
    <DSVizLibPath Condition="'$(DSVizLibPath)' == ''">$(DSVizInstallDir)\cs\Unit4.CollectionsLib.dll</DSVizLibPath>
    <DSVizRunner Condition="'$(DSVizRunner)' == '' and '$(OS)' != 'Windows_NT' and Exists('$(DSVizInstallDir)/cs/dsviz-cs')">$(DSVizInstallDir)/cs/dsviz-cs</DSVizRunner>
    <DSVizRunner Condition="'$(DSVizRunner)' == ''">$(DSVizInstallDir)\cs\dsviz-cs.exe</DSVizRunner>

    <!-- פרויקט קונסול ב-C# (לא ספרייה), ולא כובה -->
    <_DSVizExe Condition="'$(DSVizDisable)' != 'true' and '$(Language)' == 'C#' and '$(OutputType)' == 'Exe'">true</_DSVizExe>

    <!-- הספרייה (netstandard2.0) מתאימה: ‎.NET Core 2.0+ / ‎.NET 5+ או ‎.NET Framework 4.7.2+.
         (and ב-MSBuild מקצר — VersionGreaterThanOrEquals לא נבדק כשאין TargetFrameworkVersion, למשל בבנייה החיצונית של כמה מסגרות) -->
    <_DSVizLibOk Condition="'$(_DSVizExe)' == 'true' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(TargetFrameworkVersion)' != ''
        and $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '2.0'))">true</_DSVizLibOk>
    <_DSVizLibOk Condition="'$(_DSVizExe)' == 'true' and '$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(TargetFrameworkVersion)' != ''
        and $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '4.7.2'))">true</_DSVizLibOk>

    <!-- פרופיל ההרצה: רק בפרויקט SDK (launchSettings.json) של ‎.NET 6 ומעלה -->
    <_DSVizProfileOk Condition="'$(_DSVizExe)' == 'true' and '$(UsingMicrosoftNETSdk)' == 'true'
        and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(TargetFrameworkVersion)' != ''
        and $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '6.0'))">true</_DSVizProfileOk>
    <_DSVizLaunchFile>$(MSBuildProjectDirectory)\Properties\launchSettings.json</_DSVizLaunchFile>
  </PropertyGroup>

  <!--
    1. הפניה לספרייה. רצה לפני ResolveAssemblyReferences (גם בבנייה רגילה וגם בבנייה של עיצוב-זמן —
    שתיהן מריצות אותו, כדי ש-IntelliSense יידע על ההפניות), כך שהקובץ שמתווסף כבר נכלל ברשימת
    ה-References שהמהדר מקבל.
  -->
  <Target Name="DSVizAddLibraryReference" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(_DSVizLibOk)' == 'true' and Exists('$(DSVizLibPath)')">
    <ItemGroup>
      <!-- הפרויקט כבר מפנה לספרייה? (Reference בשם, גם בצורה המלאה "Unit4.CollectionsLib, Version=...",
           או לפי ה-HintPath; או ProjectReference לפרויקט של הספרייה) — אז לא מוסיפים עוד הפניה -->
      <_DSVizExistingRef Include="@(Reference)"
          Condition="'%(Reference.Identity)' == 'Unit4.CollectionsLib'
                  or $([System.String]::Copy('%(Reference.Identity)').StartsWith('Unit4.CollectionsLib,'))
                  or $([System.String]::Copy('%(Reference.HintPath)').ToLowerInvariant().EndsWith('unit4.collectionslib.dll'))" />
      <_DSVizExistingRef Include="@(ProjectReference)" Condition="'%(ProjectReference.Filename)' == 'Unit4.CollectionsLib'" />
    </ItemGroup>
    <ItemGroup Condition="'@(_DSVizExistingRef)' == ''">
      <Reference Include="Unit4.CollectionsLib">
        <HintPath>$(DSVizLibPath)</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <!--
    2. פרופיל ההרצה. אותה נקודת-חיבור (ResolveAssemblyReferences) — רצה גם בבנייה של עיצוב-זמן, כך
    שהאפשרות "הרצה ויזואלית" מופיעה ליד כפתור ההפעלה כבר כשהפרויקט נטען ב-Visual Studio, בלי להמתין
    ל-F5 / Build. קודם קוראים את launchSettings.json (אם יש): אם הפרופיל כבר שם — ה-Exec לא רץ, כך
    שבנייה שנייה (ושלישית...) לא עושה שום דבר נוסף והבנייה/הטעינה לא מתעכבת. dsviz-cs ממזג את הפרופיל
    לתוך הקובץ (ומשאיר את הפרופילים הקיימים) ולא נכשל אף פעם.
  -->
  <Target Name="DSVizEnsureLaunchProfile" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(_DSVizProfileOk)' == 'true' and Exists('$(DSVizRunner)')">
    <ReadLinesFromFile File="$(_DSVizLaunchFile)" Condition="Exists('$(_DSVizLaunchFile)')" ContinueOnError="true">
      <Output TaskParameter="Lines" ItemName="_DSVizLaunchLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_DSVizLaunchText>@(_DSVizLaunchLines)</_DSVizLaunchText>
      <_DSVizHasProfile Condition="$(_DSVizLaunchText.Contains('הרצה ויזואלית')) and ($(_DSVizLaunchText.Contains('שליחת תרגיל')) or '$(OS)' != 'Windows_NT')">true</_DSVizHasProfile>
      <!-- פרופיל מגרסה ישנה: "commandLineArgs": "\"$(ProjectDir)\"" — ProjectDir נגמר בלוכסן, וב-Windows הנתיב מגיע
           עם מרכאה בסוף (C:\...\Targil3"). dsviz-cs ‎-‎-ensure-profile מתקן ל-"$(ProjectDir)." (רק את הארגומנט הזה).
           ב-Mac / Linux ‏MSBuild הופך \ ל-/ בשורות שנקראו מהקובץ — לכן שתי הצורות -->
      <_DSVizOldProfile Condition="'$(_DSVizHasProfile)' == 'true' and ('$(_DSVizLaunchText.Contains(`ProjectDir)\&quot;`))' == 'True'
          or '$(_DSVizLaunchText.Contains(`ProjectDir)/&quot;`))' == 'True')">true</_DSVizOldProfile>
    </PropertyGroup>
    <Exec Condition="'$(_DSVizHasProfile)' != 'true' or '$(_DSVizOldProfile)' == 'true'"
          Command="&quot;$(DSVizRunner)&quot; --ensure-profile &quot;$(MSBuildProjectDirectory)&quot;"
          ContinueOnError="true" IgnoreExitCode="true" EchoOff="true" Timeout="60000"
          StandardOutputImportance="Low" StandardErrorImportance="Low" />
  </Target>

  <!--
    3. Stack / Queue כפולים, ו-using Unit4.CollectionsLib; לבד. בפרויקט קונסול חדש של Visual Studio (‎.NET 6+) ‎ImplicitUsings‎ פעיל,
    כלומר ‎using System.Collections.Generic;‎ "מוסתר" בכל קובץ — ואז ‎Stack<int>‎ ו-‎Queue<int>‎ מהספרייה נתקלים ב-‎CS0104‎
    (הפניה דו-משמעית) — שגיאה באנגלית שתלמיד לא יכול לתקן, כי אין שורה למחוק.
      א. הקוד כבר כותב using Unit4.CollectionsLib; — מוציאים את System.Collections.Generic מהרשימה המוסתרת.
      ב. הקוד לא נוגע באוספים של ‎.NET (List, Dictionary, HashSet..., Enqueue / Dequeue / Peek, או using System.Collections.Generic
         בעצמו) — מוסיפים לכל הפרויקט ‎global using Unit4.CollectionsLib;‎ (ומוציאים את System.Collections.Generic): בפרויקט רגיל
         כותבים Queue<int> / Stack<int> / Node<int> / BinNode<int> בלי שום שורה בראש הקובץ — בדיוק כמו בתבנית של DSViz.
      ג. הקוד משתמש באוספים של ‎.NET — לא נוגעים (מי שצריך גם את הספרייה כותב using Unit4.CollectionsLib; ואז ‎א‎).
    ב — רק כשההפניה לספרייה באמת קיימת (שלב 1), ורק בפרויקט SDK של ‎.NET 6+ (global using). אותו כלל בדיוק ב-dsviz-cs (ההרצה
    הוויזואלית). רץ לפני יצירת קובץ ה-global usings (גם בבנייה של עיצוב-זמן, כדי ש-IntelliSense יכיר את Queue ולא יסמן אדום).
  -->
  <Target Name="DSVizResolveImplicitUsings" BeforeTargets="GenerateGlobalUsings" Condition="'$(_DSVizExe)' == 'true'">
    <ItemGroup>
      <_DSVizCsFile Include="@(Compile)" Condition="'%(Extension)' == '.cs' and Exists('%(FullPath)')" />
    </ItemGroup>
    <ItemGroup>
      <_DSVizLibSource Include="@(_DSVizCsFile)" Condition="$([System.IO.File]::ReadAllText('%(FullPath)').Contains('Unit4.CollectionsLib'))" />
      <_DSVizBclSource Include="@(_DSVizCsFile)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_DSVizBclPattern)'))" />
    </ItemGroup>
    <PropertyGroup>
      <_DSVizAutoUsing Condition="'@(_DSVizLibSource)' == '' and '@(_DSVizBclSource)' == '' and '$(_DSVizProfileOk)' == 'true'
          and '$(_DSVizLibOk)' == 'true' and Exists('$(DSVizLibPath)')">true</_DSVizAutoUsing>
    </PropertyGroup>
    <ItemGroup Condition="'$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true'">
      <Using Remove="System.Collections.Generic" Condition="'@(_DSVizLibSource)' != '' or '$(_DSVizAutoUsing)' == 'true'" />
    </ItemGroup>
    <ItemGroup Condition="'$(_DSVizAutoUsing)' == 'true'">
      <Using Include="Unit4.CollectionsLib" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <!-- קוד שמשתמש באוספים של ‎.NET (ואז לא מוסיפים את הספרייה לבד) — אותו ביטוי כמו ב-dsviz-cs (Program.cs: BclCollections) -->
    <_DSVizBclPattern>\b(List|Dictionary|HashSet|SortedSet|SortedDictionary|SortedList|LinkedList|KeyValuePair|IEnumerable|ICollection|IList|IDictionary|IReadOnlyList|IReadOnlyCollection|IReadOnlyDictionary|Comparer|EqualityComparer)\s*&lt;|\.(Enqueue|Dequeue|Peek|TryPeek|TryPop|TryDequeue|EnsureCapacity)\s*\(|System\.Collections\.Generic</_DSVizBclPattern>
  </PropertyGroup>

</Project>
