            "dsviz": [
                {
                    "id": "dsviz.home",
                    "name": "תרגיל חדש",
                    "when": "!dsviz.off"
                },
                {
                    "id": "dsviz.insertView",
                    "name": "הוסף מבנה נתונים",
                    "when": "!dsviz.off"
