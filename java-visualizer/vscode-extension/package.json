{
    "name": "dsviz",
    "displayName": "מבני נתונים — הרצה ויזואלית",
    "description": "תרגילי מחסנית, תור, רשימה מקושרת ועצים (unit4) עם תצוגה ויזואלית של כל צעד בהרצה",
    "version": "1.0.1",
    "publisher": "lamerhav",
    "license": "SEE LICENSE IN README.md",
    "icon": "media/icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Education",
        "Visualization"
    ],
    "keywords": [
        "java",
        "csharp",
        "stack",
        "queue",
        "linked list",
        "binary tree",
        "unit4",
        "בגרות"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished",
        "onLanguage:java",
        "onLanguage:csharp"
    ],
    "contributes": {
        "commands": [
            {
                "command": "dsviz.newExercise",
                "title": "תרגיל חדש...",
                "category": "מבני נתונים",
                "icon": "media/new.svg"
            },
            {
                "command": "dsviz.newStack",
                "title": "תרגיל חדש: מחסנית",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.newQueue",
                "title": "תרגיל חדש: תור",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.newList",
                "title": "תרגיל חדש: רשימה מקושרת",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.newTree",
                "title": "תרגיל חדש: עץ בינארי",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.newBst",
                "title": "תרגיל חדש: עץ חיפוש בינארי",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.newArray",
                "title": "תרגיל חדש: מערך",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.newMatrix",
                "title": "תרגיל חדש: מערך דו-ממדי",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.run",
                "title": "הרצה ויזואלית",
                "category": "מבני נתונים",
                "icon": "media/run.svg"
            },
            {
                "command": "dsviz.examples",
                "title": "דוגמאות פתורות",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert",
                "title": "הוסף מבנה נתונים...",
                "category": "מבני נתונים",
                "icon": "media/insert.svg"
            },
            {
                "command": "dsviz.insert.stack",
                "title": "הוסף מבנה נתונים: מחסנית",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert.queue",
                "title": "הוסף מבנה נתונים: תור",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert.list",
                "title": "הוסף מבנה נתונים: רשימה מקושרת",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert.tree",
                "title": "הוסף מבנה נתונים: עץ בינארי",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert.bst",
                "title": "הוסף מבנה נתונים: עץ חיפוש בינארי",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert.array",
                "title": "הוסף מבנה נתונים: מערך",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert.matrix",
                "title": "הוסף מבנה נתונים: מערך דו-ממדי",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert.student",
                "title": "הוסף מבנה נתונים: תלמיד",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.insert.car",
                "title": "הוסף מבנה נתונים: מכונית",
                "category": "מבני נתונים"
            },
            {
                "command": "dsviz.openProject",
                "title": "פתיחת תיקיית התרגילים",
                "category": "מבני נתונים",
                "icon": "$(folder-opened)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "dsviz",
                    "title": "מבני נתונים",
                    "icon": "media/activity.svg"
                }
            ]
        },
        "views": {
            "dsviz": [
                {
                    "id": "dsviz.home",
                    "name": "תרגיל חדש"
                },
                {
                    "id": "dsviz.insertView",
                    "name": "הוסף מבנה נתונים"
                },
                {
                    "id": "dsviz.runView",
                    "name": "הרצה"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "dsviz.home",
                "when": "workbenchState == empty",
                "contents": "עוד לא פתוחה תיקייה. תיקיית התרגילים כבר מוכנה (עם תרגיל לדוגמה ודוגמאות פתורות):\n[פתיחת תיקיית התרגילים](command:dsviz.openProject)"
            },
            {
                "view": "dsviz.home",
                "contents": "בחרו מבנה — וייפתח תרגיל מוכן, ונשאר רק לכתוב את הפעולה:\n[מחסנית  (Stack)](command:dsviz.newStack)\n[תור  (Queue)](command:dsviz.newQueue)\n[רשימה מקושרת  (Node)](command:dsviz.newList)\n[עץ בינארי  (BinNode)](command:dsviz.newTree)\n[עץ חיפוש בינארי](command:dsviz.newBst)\n[מערך  (int[])](command:dsviz.newArray)\n[מערך דו-ממדי  (int[][])](command:dsviz.newMatrix)\nבכל מבנה אפשר לבחור גם Student (תלמידים) או Car (מכוניות).\n[דוגמאות פתורות](command:dsviz.examples)",
                "when": "workbenchState != empty"
            },
            {
                "view": "dsviz.insertView",
                "contents": "בוחרים מבנה, ערכים (או אקראיים) ושם — והמבנה נבנה בקוד במקום הסמן, עם ציור של איך הוא ייראה:\n[הוסף מבנה נתונים...](command:dsviz.insert)\nאו ישר מבנה מסוים:\n[מחסנית](command:dsviz.insert.stack)  [תור](command:dsviz.insert.queue)  [רשימה מקושרת](command:dsviz.insert.list)\n[עץ בינארי](command:dsviz.insert.tree)  [עץ חיפוש](command:dsviz.insert.bst)  [מערך](command:dsviz.insert.array)\n[מערך דו-ממדי](command:dsviz.insert.matrix)  [תלמיד](command:dsviz.insert.student)  [מכונית](command:dsviz.insert.car)"
            },
            {
                "view": "dsviz.runView",
                "contents": "אחרי שכותבים את הקוד:\n[▶  הרצה ויזואלית](command:dsviz.run)\nבחלון רואים כל שורה בקוד, את המשתנים ואת מבני הנתונים — צעד אחר צעד.\nהרצה רגילה (Run) מדפיסה רק לקונסול."
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "dsviz.newExercise",
                    "when": "resourceLangId == java || resourceLangId == csharp",
                    "group": "navigation@1"
                },
                {
                    "command": "dsviz.insert",
                    "when": "resourceLangId == java || resourceLangId == csharp",
                    "group": "navigation@2"
                },
                {
                    "command": "dsviz.run",
                    "when": "resourceLangId == java || resourceLangId == csharp",
                    "group": "navigation@3"
                }
            ],
            "explorer/context": [
                {
                    "command": "dsviz.newExercise",
                    "group": "navigation@9"
                }
            ],
            "editor/context": [
                {
                    "submenu": "dsviz.editorMenu",
                    "when": "resourceLangId == java || resourceLangId == csharp",
                    "group": "0_dsviz"
                }
            ],
            "dsviz.editorMenu": [
                {
                    "command": "dsviz.insert",
                    "group": "1_insert@0"
                },
                {
                    "submenu": "dsviz.insertMenu",
                    "group": "1_insert"
                },
                {
                    "command": "dsviz.run",
                    "group": "2_run@1"
                }
            ],
            "dsviz.insertMenu": [
                {
                    "command": "dsviz.insert.stack",
                    "group": "1@0"
                },
                {
                    "command": "dsviz.insert.queue",
                    "group": "1@1"
                },
                {
                    "command": "dsviz.insert.list",
                    "group": "1@2"
                },
                {
                    "command": "dsviz.insert.tree",
                    "group": "1@3"
                },
                {
                    "command": "dsviz.insert.bst",
                    "group": "1@4"
                },
                {
                    "command": "dsviz.insert.array",
                    "group": "1@5"
                },
                {
                    "command": "dsviz.insert.matrix",
                    "group": "1@6"
                },
                {
                    "command": "dsviz.insert.student",
                    "group": "1@7"
                },
                {
                    "command": "dsviz.insert.car",
                    "group": "1@8"
                }
            ],
            "commandPalette": [
                {
                    "command": "dsviz.insert.stack",
                    "when": "editorLangId == java || editorLangId == csharp"
                },
                {
                    "command": "dsviz.insert.queue",
                    "when": "editorLangId == java || editorLangId == csharp"
                },
                {
                    "command": "dsviz.insert.list",
                    "when": "editorLangId == java || editorLangId == csharp"
                },
                {
                    "command": "dsviz.insert.tree",
                    "when": "editorLangId == java || editorLangId == csharp"
                },
                {
                    "command": "dsviz.insert.bst",
                    "when": "editorLangId == java || editorLangId == csharp"
                },
                {
                    "command": "dsviz.insert.array",
                    "when": "editorLangId == java || editorLangId == csharp"
                },
                {
                    "command": "dsviz.insert.matrix",
                    "when": "editorLangId == java || editorLangId == csharp"
                },
                {
                    "command": "dsviz.insert.student",
                    "when": "editorLangId == java || editorLangId == csharp"
                },
                {
                    "command": "dsviz.insert.car",
                    "when": "editorLangId == java || editorLangId == csharp"
                }
            ]
        },
        "keybindings": [
            {
                "command": "dsviz.run",
                "key": "ctrl+alt+r",
                "mac": "cmd+alt+r",
                "when": "editorLangId == java || editorLangId == csharp"
            },
            {
                "command": "dsviz.insert",
                "key": "ctrl+alt+i",
                "mac": "cmd+alt+i",
                "when": "editorLangId == java || editorLangId == csharp"
            }
        ],
        "submenus": [
            {
                "id": "dsviz.editorMenu",
                "label": "מבני נתונים"
            },
            {
                "id": "dsviz.insertMenu",
                "label": "הוסף מבנה נתונים"
            }
        ],
        "configuration": {
            "title": "מבני נתונים",
            "properties": {
                "dsviz.language": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "java",
                        "csharp"
                    ],
                    "default": "auto",
                    "description": "באיזו שפה כותבים תרגילים חדשים: auto = לפי הקובץ הפתוח והתיקייה (ואם לא ברור — שואלים)"
                },
                "dsviz.csRunner": {
                    "type": "string",
                    "default": "",
                    "description": "הנתיב ל-dsviz-cs.exe (ההרצה הוויזואלית של C#). ריק = זה שהותקן עם מבני נתונים"
                },
                "dsviz.javaHome": {
                    "type": "string",
                    "default": "",
                    "description": "תיקיית JDK להרצה (ריק = ה-Java שהותקנה עם מבני נתונים, או JAVA_HOME, או PATH)"
                }
            }
        }
    }
}
