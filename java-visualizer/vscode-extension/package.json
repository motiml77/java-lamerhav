{
    "name": "dsviz",
    "displayName": "מבני נתונים — הרצה ויזואלית",
    "description": "תרגילי מחסנית, תור, רשימה מקושרת ועצים (unit4) עם תצוגה ויזואלית של כל צעד בהרצה",
    "version": "1.0.1",
    "publisher": "lamerhav",
    "author": {
        "name": "Moti Levi",
        "email": "motiml77@gmail.com"
    },
    "license": "SEE LICENSE IN README.md",
    "icon": "media/icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Education",
        "Visualization"
    ],
    "keywords": [
        "java",
        "csharp",
        "stack",
        "queue",
        "linked list",
        "binary tree",
        "unit4",
        "בגרות"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished",
        "onLanguage:java",
        "onLanguage:csharp"
    ],
