<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<!--
  "מאגר תרגילים" — הרחבה (fragment) של DSViz ל-Eclipse, לבדיקה בלבד: מעתיקים את il.lamerhav.dsviz.bank_*.jar לתיקיית dropins
  ליד התוסף הראשי. לא חלק מההתקנה לתלמידים, והעדכון האוטומטי (שמחליף רק il.lamerhav.dsviz_*.jar) לא נוגע בה.
-->
<fragment>
   <extension point="org.eclipse.ui.commands">
      <command id="il.lamerhav.dsviz.bank" categoryId="il.lamerhav.dsviz.category"
               name="מאגר תרגילים" description="בוחרים נושא ושאלה מהמאגר — ונוצר תרגיל מוכן עם פעולה לכל סעיף, main והצעה לפתרון"/>
      <command id="il.lamerhav.dsviz.bankQuestion" categoryId="il.lamerhav.dsviz.category"
               name="השאלה" description="חלון צף עם הנוסח של השאלה מהמאגר (של התרגיל שפתוח בעורך)"/>
      <command id="il.lamerhav.dsviz.teacherPanel" categoryId="il.lamerhav.dsviz.category"
               name="עמדת ניהול" description="עמדת הניהול של המורה: הקוד לחיבור עמדות מחשב, ופתיחת עמדת הניהול בדפדפן (פעיל רק למורה מחובר)"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="il.lamerhav.dsviz.bank" class="il.lamerhav.dsviz.BankHandler"/>
      <!-- "השאלה" פעיל רק כשיש שאלה להציג: בעורך פתוח תרגיל מהמאגר, או שחלון השאלה פתוח -->
      <handler commandId="il.lamerhav.dsviz.bankQuestion" class="il.lamerhav.dsviz.BankQuestionHandler">
         <enabledWhen>
            <with variable="il.lamerhav.dsviz.bankQuestion"><equals value="true"/></with>
         </enabledWhen>
      </handler>
      <!-- "עמדת ניהול" פעיל רק למורה שמחובר באמת -->
      <handler commandId="il.lamerhav.dsviz.teacherPanel" class="il.lamerhav.dsviz.TeacherPanelHandler">
         <enabledWhen>
            <with variable="il.lamerhav.dsviz.teacher"><equals value="true"/></with>
         </enabledWhen>
      </handler>
   </extension>

   <extension point="org.eclipse.ui.services">
      <sourceProvider provider="il.lamerhav.dsviz.BankQuestionSource">
         <variable name="il.lamerhav.dsviz.bankQuestion" priorityLevel="workbench"/>
      </sourceProvider>
      <sourceProvider provider="il.lamerhav.dsviz.TeacherSource">
         <variable name="il.lamerhav.dsviz.teacher" priorityLevel="workbench"/>
      </sourceProvider>
   </extension>

   <extension point="org.eclipse.ui.commandImages">
      <image commandId="il.lamerhav.dsviz.bank" icon="icons/bank.png"/>
      <image commandId="il.lamerhav.dsviz.bankQuestion" icon="icons/question.png"/>
      <image commandId="il.lamerhav.dsviz.teacherPanel" icon="icons/teacher.png"/>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <!-- בסרגל של DSViz, לפני "הרצה ויזואלית" -->
      <menuContribution locationURI="toolbar:il.lamerhav.dsviz.toolbar?before=run">
         <command commandId="il.lamerhav.dsviz.bank" label="מאגר תרגילים" mode="FORCE_TEXT" id="il.lamerhav.dsviz.bank.toolbar"
                  tooltip="מאגר תרגילים: בוחרים נושא ושאלה (קל / בינוני / קשה) — ונוצר תרגיל מוכן, עם הצעה לפתרון לכל סעיף" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <command commandId="il.lamerhav.dsviz.bankQuestion" label="השאלה" mode="FORCE_TEXT" id="il.lamerhav.dsviz.bankQuestion.toolbar"
                  tooltip="השאלה: חלון צף עם הנוסח של התרגיל מהמאגר — סוגרים ופותחים מתי שרוצים" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <command commandId="il.lamerhav.dsviz.teacherPanel" label="עמדת ניהול" mode="FORCE_TEXT" id="il.lamerhav.dsviz.teacherPanel.toolbar"
                  tooltip="עמדת ניהול של המורה: הקוד לחיבור עמדות מחשב ופתיחת עמדת הניהול בדפדפן (פעיל רק אחרי כניסה כמורה)" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
      </menuContribution>
      <!-- בתפריט "מבני נתונים" -->
      <menuContribution locationURI="menu:il.lamerhav.dsviz.menu?after=additions">
         <command commandId="il.lamerhav.dsviz.bank" label="מאגר תרגילים..." style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
         <command commandId="il.lamerhav.dsviz.bankQuestion" label="חלון השאלה (מאגר תרגילים)" style="push">
            <visibleWhen checkEnabled="false"><with variable="il.lamerhav.dsviz.active"><equals value="true"/></with></visibleWhen>
         </command>
      </menuContribution>
   </extension>


</fragment>
