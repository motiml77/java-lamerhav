<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <!-- הסמלים המובנים של Visual Studio (Image Catalog) — מתאימים לבד לערכה בהירה / כהה ולגודל המסך -->
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidDsVizPackage">
    <Menus>
      <!-- סרגל כלים בפני עצמו, מוצג בראש החלון כברירת מחדל (DefaultDocked) — View ← Toolbars ← DSViz -->
      <Menu guid="guidDsVizCmdSet" id="DsVizToolbar" priority="0x0100" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>DSViz</ButtonText>
          <CommandName>DSViz</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidDsVizCmdSet" id="DsVizToolbarGroup" priority="0x0000">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbar" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidDsVizCmdSet" id="CmdNew" priority="0x0100" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="NewDocument" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>תרגיל חדש</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdInsert" priority="0x0200" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Hierarchy" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>הוספת מבנה נתונים</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdBank" priority="0x0300" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Library" />
        <!-- תמיד גלוי ולחיץ (כש-DSViz פועל); אם המאגר חסר, הלחיצה מתקנת או מסבירה (BankReady ב-DsVizPackage) -->
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>מאגר שאלות</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdQuestion" priority="0x0350" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Document" />
        <!-- תמיד גלוי ולחיץ (כש-DSViz פועל); אם המאגר חסר, הלחיצה מתקנת או מסבירה (BankReady ב-DsVizPackage) -->
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>השאלה</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdSubmit" priority="0x0400" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Send" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>שליחת תרגיל</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdRun" priority="0x0600" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Run" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>הרצה ויזואלית</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdHelp" priority="0x0700" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="StatusHelp" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>הדרכה</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdTeacher" priority="0x0800" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="User" />
        <!-- עמדת הניהול של המורה (כמו בסרגל של Eclipse): מוצגת רק כשהמשתמש מחובר כמורה — הסימון teacher.flag (BeforeQueryStatus ב-DsVizPackage) -->
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>עמדת ניהול</ButtonText></Strings>
      </Button>
      <!-- כיבוי / הפעלה של כל DSViz (Power.cs), בסוף הסרגל: אדום "כיבוי DSViz" כש-DSViz פועל, ירוק "הפעלת DSViz" כשהוא כבוי — אז כל שאר
           הכפתורים מוסתרים. שני כפתורים ולא אחד שמחליף סמל: בסרגל של Visual Studio אי אפשר להחליף סמל של פקודה בזמן ריצה.
           הסמלים: אותם PNG של Eclipse / IntelliJ (eclipse-plugin/icons/power-off.png, power-on.png), ברצועה אחת של 16x16 — Resources\PowerIcons.png -->
      <Button guid="guidDsVizCmdSet" id="CmdPowerOff" priority="0x0F00" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="guidDsVizPowerImages" id="bmpPowerOff" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>כיבוי DSViz</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdPowerOn" priority="0x0F01" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <Icon guid="guidDsVizPowerImages" id="bmpPowerOn" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings><ButtonText>הפעלת DSViz</ButtonText></Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidDsVizPowerImages" href="Resources\PowerIcons.png" usedList="bmpPowerOff, bmpPowerOn" />
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidDsVizPackage" value="{7b2f4d1e-9c3a-4e68-b0d5-1a8c6f3e2d97}" />
    <GuidSymbol name="guidDsVizCmdSet" value="{a1f6a3c2-5d9e-4b7a-8c11-3e7f2d9b6a40}">
      <IDSymbol name="DsVizToolbar" value="0x1000" />
      <IDSymbol name="DsVizToolbarGroup" value="0x1010" />
      <IDSymbol name="CmdNew" value="0x0101" />
      <IDSymbol name="CmdInsert" value="0x0102" />
      <IDSymbol name="CmdBank" value="0x0103" />
      <IDSymbol name="CmdSubmit" value="0x0104" />
      <IDSymbol name="CmdRun" value="0x0106" />
      <IDSymbol name="CmdHelp" value="0x0107" />
      <IDSymbol name="CmdTeacher" value="0x0108" />
      <IDSymbol name="CmdQuestion" value="0x0109" />
      <IDSymbol name="CmdPowerOff" value="0x010A" />
      <IDSymbol name="CmdPowerOn" value="0x010B" />
    </GuidSymbol>
    <GuidSymbol name="guidDsVizPowerImages" value="{3c8e5b7a-2f14-4d69-9a0b-6e1d4c7f8a25}">
      <IDSymbol name="bmpPowerOff" value="1" />
      <IDSymbol name="bmpPowerOn" value="2" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
