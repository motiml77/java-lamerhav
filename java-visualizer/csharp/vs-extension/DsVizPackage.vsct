<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidDsVizPackage">
    <Menus>
      <!-- סרגל כלים בפני עצמו, מוצג בראש החלון כברירת מחדל (DefaultDocked) — View ← Toolbars ← DSViz -->
      <Menu guid="guidDsVizCmdSet" id="DsVizToolbar" priority="0x0100" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>DSViz</ButtonText>
          <CommandName>DSViz</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidDsVizCmdSet" id="DsVizToolbarGroup" priority="0x0000">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbar" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidDsVizCmdSet" id="CmdNew" priority="0x0100" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <CommandFlag>TextOnly</CommandFlag>
        <Strings><ButtonText>תרגיל חדש</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdInsert" priority="0x0200" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <CommandFlag>TextOnly</CommandFlag>
        <Strings><ButtonText>הוספת מבנה נתונים</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdBank" priority="0x0300" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <!-- מאגר השאלות הוא של המעבדה בלבד: מוצג רק כשהוא מותקן (BeforeQueryStatus ב-DsVizPackage) -->
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextOnly</CommandFlag>
        <Strings><ButtonText>מאגר שאלות</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdSubmit" priority="0x0400" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <CommandFlag>TextOnly</CommandFlag>
        <Strings><ButtonText>שליחת תרגיל</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdRun" priority="0x0600" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <CommandFlag>TextOnly</CommandFlag>
        <Strings><ButtonText>הרצה ויזואלית</ButtonText></Strings>
      </Button>
      <Button guid="guidDsVizCmdSet" id="CmdHelp" priority="0x0700" type="Button">
        <Parent guid="guidDsVizCmdSet" id="DsVizToolbarGroup" />
        <CommandFlag>TextOnly</CommandFlag>
        <Strings><ButtonText>הדרכה</ButtonText></Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidDsVizPackage" value="{7b2f4d1e-9c3a-4e68-b0d5-1a8c6f3e2d97}" />
    <GuidSymbol name="guidDsVizCmdSet" value="{a1f6a3c2-5d9e-4b7a-8c11-3e7f2d9b6a40}">
      <IDSymbol name="DsVizToolbar" value="0x1000" />
      <IDSymbol name="DsVizToolbarGroup" value="0x1010" />
      <IDSymbol name="CmdNew" value="0x0101" />
      <IDSymbol name="CmdInsert" value="0x0102" />
      <IDSymbol name="CmdBank" value="0x0103" />
      <IDSymbol name="CmdSubmit" value="0x0104" />
      <IDSymbol name="CmdRun" value="0x0106" />
      <IDSymbol name="CmdHelp" value="0x0107" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
