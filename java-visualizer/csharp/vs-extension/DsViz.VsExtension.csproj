<Project Sdk="Microsoft.NET.Sdk">

  <!-- הרחבה ל-Visual Studio (VisualStudio.Extensibility, מחוץ לתהליך): סרגל כלים של DSViz בפני עצמו, בראש החלון.
       בנייה: dotnet build -c Release (על Windows; ב-CI: .github/workflows/dsviz-vs.yml) → bin\Release\...\DsViz.VsExtension.vsix -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DsViz.VsExtension</RootNamespace>
    <AssemblyName>DsViz.VsExtension</AssemblyName>
    <Version>1.0.1</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ExtensionAssemblyVersion>1.0.1</ExtensionAssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
  </ItemGroup>

  <ItemGroup>
    <Content Include=".vsextension\string-resources.json" />
  </ItemGroup>

</Project>
