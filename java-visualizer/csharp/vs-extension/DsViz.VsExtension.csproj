<Project Sdk="Microsoft.NET.Sdk">

  <!-- הרחבה ל-Visual Studio (VSIX רגיל, בתוך התהליך): סרגל כלים של DSViz בפני עצמו, בראש החלון (DefaultDocked), בלי הרשאות מנהל להתקנה.
       בנייה: msbuild /restore -p:Configuration=Release (על Windows; ב-CI: .github/workflows/dsviz-vsix.yml) → bin\Release\net472\DsViz.VsExtension.vsix -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DsViz.VsExtension</RootNamespace>
    <AssemblyName>DsViz.VsExtension</AssemblyName>
    <Version>1.0.1</Version>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.12.40392" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest"><SubType>Designer</SubType></None>
    <VSCTCompile Include="DsVizPackage.vsct"><ResourceName>Menus.ctmenu</ResourceName></VSCTCompile>
  </ItemGroup>

</Project>
