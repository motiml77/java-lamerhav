{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "screenshots/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/lamerhav",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/manage",
        "destination": "/app.html"
      },
      {
        "regex": "^/[a-z0-9][a-z0-9-]{1,28}[a-z0-9](/app)?$",
        "destination": "/app.html"
      }
    ]
  }
}
